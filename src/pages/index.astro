---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const posts = (await getCollection("blog", ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
---

<BaseLayout>
  <section class="hero">
    <div>
      <span class="kicker">embedded systems / software </span>
      <h1>Minigrim0</h1>
      <p>
        Software Engineer at <a hreaf="https://www.saltoftheearthnatural.com/en">Salt of the earth</a>, 
        former <a href="https://urlab.be">UrLab</a> member.
      </p>
      <div class="link-row">
        <a class="pill" href="/cv/">cv</a>
        <a class="pill" href="/projects/">projects</a>
        <a class="pill" href="https://minigrim0.itch.io/">games</a>
        <a class="pill" href="https://github.com/Minigrim0">github</a>
      </div>
    </div>
    <img class="hero-avatar" src="/img/minigrim0.jpeg" alt="Florent Grimau avatar" width="336" height="336" />
  </section>

  <section class="section">
    <h2 class="section-title">what i'm about</h2>
    <div>
      <p class="lede">
        I like systems where software has consequences beyond a screen: embedded devices, audio processing,
        automation, operating systems, and practical tools that make technical communities move faster.
      </p>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">selected projects</h2>
    <div class="grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <h2 class="section-title">latest writing</h2>
        <div class="list">
          {posts.slice(0, 3).map((post) => (
            <article class="card">
                <a class="card-link" href={`/blog/${post.id}/`}>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="card-meta">
                  {post.data.published.toLocaleDateString("en", { year: "numeric", month: "short", day: "2-digit" })}
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
