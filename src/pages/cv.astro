---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const cv = await getEntry("cv", "profile");

if (!cv) {
  throw new Error("Missing CV profile content.");
}
---

<BaseLayout title="CV" description={cv.data.summary}>
  <header class="cv-header">
    <div>
      <span class="kicker">{cv.data.location}</span>
      <h1>{cv.data.name}</h1>
      <p>{cv.data.summary}</p>
      <div class="link-row">
        <a class="pill" href={`mailto:${cv.data.email}`}>{cv.data.email}</a>
        <a class="pill" href={`https://github.com/${cv.data.github}`}>github/{cv.data.github}</a>
      </div>
    </div>
    <img class="cv-avatar" src="/img/minigrim0.jpeg" alt="Florent Grimau avatar" width="264" height="264" />
  </header>

  <section class="section">
    <h2 class="section-title">experience</h2>
    <div class="timeline">
      {cv.data.experience.map((item) => (
        <article class="timeline-item">
          <div class="timeline-date">{item.period}</div>
          <div>
            <h3>{item.role}</h3>
            <div class="timeline-place">
              {item.url ? <a href={item.url}>{item.organization}</a> : item.organization} - {item.location}
            </div>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">education</h2>
    <div class="timeline">
      {cv.data.education.map((item) => (
        <article class="timeline-item">
          <div class="timeline-date">{item.period}</div>
          <div>
            <h3>{item.program}</h3>
            <div class="timeline-place">
              {item.url ? <a href={item.url}>{item.institution}</a> : item.institution} - {item.location}
            </div>
            <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">skills</h2>
    <div class="skills">
      {cv.data.skills.map((group) => (
        <article class="card">
          <h3>{group.group}</h3>
          <div class="tag-row">
            {group.items.map((item) => <span class="pill">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">community</h2>
    <div class="timeline">
      {cv.data.community.map((item) => (
        <article class="timeline-item">
          <div class="timeline-date">{item.period}</div>
          <div>
            <h3>{item.role}</h3>
            <div class="timeline-place">
              {item.url ? <a href={item.url}>{item.organization}</a> : item.organization} - {item.location}
            </div>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">achievements</h2>
    <div class="timeline">
      {cv.data.achievements.map((item) => (
        <article class="timeline-item">
          <div class="timeline-date">{item.period}</div>
          <div>
            <h3>{item.url ? <a href={item.url}>{item.name}</a> : item.name}</h3>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">interests</h2>
    <div class="skills">
      {cv.data.interests.map((group) => (
        <article class="card">
          <h3>{group.group}</h3>
          <div class="tag-row">
            {group.items.map((item) => <span class="pill">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
